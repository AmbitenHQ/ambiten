{
  "extends": "../../tsconfig.base.json", // Inherit common settings
  "compilerOptions": {
    "target": "ES2022",                                                                                   
    "rootDir": "src",
    "outDir": "dist/cjs",                                                                                                                                                                    
    "composite": true,
    "types": ["node", "jest"],
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolvePackageJsonExports":false,
    "emitDeclarationOnly": false, 
    "sourceMap": true,        
    "allowJs": false,               
    "tsBuildInfoFile": "../../.cache/tsbuildinfo/adapter-runtime/cjs.tsbuildinfo"         
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "assets"
  ],
    "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__test__/**",
    "src/**/__tests__/**"
  ]
}