{
  "extends": "../../tsconfig.base.json", // Inherit common settings
  "compilerOptions": {                                                                                   
    "rootDir": "src",
    "outDir": "dist/cjs",                                                                                                                                                                   
    "declaration": true,  
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "resolvePackageJsonExports":false,
    "allowJs": false,
    "tsBuildInfoFile": "../../.cache/tsbuildinfo/core/cjs.tsbuildinfo"            
  },
   "files": [],
  "references": [
    { "path": "../logger" }, // Reference to other local packages
    { "path": "../adapter-types" },
    { "path": "../adapter-types/tsconfig.esm.json" }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "assets"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__test__/**",
    "src/**/__tests__/**"
  ]
}