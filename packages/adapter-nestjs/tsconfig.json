{
  "extends": "../../tsconfig.base.json", // Inherit common settings
  "compilerOptions": {                                                                                   
    "rootDir": "src",
    "outDir": "dist/cjs",                                                                                                                                                                   
    "types": ["node", "jest"],
		"composite": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,  
    "resolveJsonModule": true, 
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolvePackageJsonExports":false,
    "sourceMap": true,
    "noEmit": false, 
    "allowJs": false,
    "tsBuildInfoFile": "../../.cache/tsbuildinfo/adapter-nestjs/cjs.tsbuildinfo"              
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "assets"
  ],
    "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__test__/**",
    "src/**/__tests__/**"
  ]
}