{
  "name": "@ambiten/adapter-graphql",
  "version": "2.0.0",
  "description": "Ambiten adapter for GraphQL",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build:esm": "tsc -b tsconfig.esm.json -force",
    "build:cjs": "tsc -b tsconfig.json -force && node scripts/fix-esm-extensions.mjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "test": "jest --detectOpenHandles --coverage",
    "changeset": "pnpm run changeset",
    "clean": "rimraf dist && rimraf ../../.cache/tsbuildinfo/adapter-graphql",
    "release": "pnpm changeset version",
    "prepack": "pnpm build",
    "postbuild:esm": "node scripts/add-esm-type.js",
    "publish": "pnpm --recursive publish --access public --tag latest --no-git-checks"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbitenHQ/ambiten.git",
    "directory": "packages/adapter-graphql"
  },
  "bugs": {
    "url": "https://github.com/AmbitenHQ/ambiten/issues"
  },
  "homepage": "https://docs.ambiten.dev",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ambiten/adapter-runtime": "workspace:^",
    "@ambiten/adapter-types": "workspace:^"
  },
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}